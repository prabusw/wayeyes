#!/usr/bin/env sh
SERVICE_NAME="wayeyes"
I3BLOCKS_SIGNAL=3

svc() {
    if command -v rc-service >/dev/null 2>&1; then
        rc-service -U "$SERVICE_NAME" "$1"
    elif command -v systemctl >/dev/null 2>&1; then
        systemctl --user "$1" "$SERVICE_NAME"
    else
        notify-send "$SERVICE_NAME" "No supported service manager found"
        exit 1
    fi
}

if svc status >/dev/null 2>&1; then
    svc stop
    notify-send "$SERVICE_NAME stopped"
else
    svc start
	sleep 2
    notify-send "$SERVICE_NAME started"
fi

pkill -RTMIN+$I3BLOCKS_SIGNAL i3blocks 2>/dev/null
