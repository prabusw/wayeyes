[Unit]
Description=Screen blanker service for Wayland compositors to protect your eyes
After=graphical-session.target
Requires=graphical-session.target

[Service]
Type=simple
Environment="XDG_RUNTIME_DIR=/run/user/%U"
ExecStart=%h/.local/bin/wayeyes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
