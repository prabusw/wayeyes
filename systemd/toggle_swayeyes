#!/usr/bin/env sh

# --- Configuration ---
# Absolute path to the service command for Systemd User services
SERVICE_CMD="/usr/bin/systemctl" # Base command for systemctl
SERVICE_SCOPE="--user"           # Specifies to manage user services
SERVICE_NAME="swayeyes.service"  # Systemd service unit name, include .service suffix

# Notification command (use notify-send for standard notifications)
NOTIFY_CMD="notify-send"
NOTIFICATION_ID=0

# --- Wait for Service to Reach Target State ---
MAX_WAIT_TIME=20   # Max seconds to wait for service state change
POLLING_INTERVAL=1 # Check every 1 second
elapsed_time=0

# --- Helper Functions ---

# Function to get current service status for Systemd
get_service_status() {
    # systemctl is-active returns 0 for 'active', 1 for 'inactive' or 'failed'
    "$SERVICE_CMD" "$SERVICE_SCOPE" is-active --quiet "$SERVICE_NAME"
    local status_code=$?

    if [ "$status_code" -eq 0 ]; then
        echo "started" # Service is active/running
    else
        echo "stopped" # Service is inactive/stopped/failed
    fi
}

# Get the initial state of the service, notify and toggle the service state
initial_state=$(get_service_status)

if [ "$initial_state" = "started" ]; then
    # If it was already started, stop it
    desired_state="stopped"
    NOTIFICATION_ID=$("$NOTIFY_CMD" -p "$SERVICE_NAME will be $desired_state shortly")
    "$SERVICE_CMD" "$SERVICE_SCOPE" stop "$SERVICE_NAME"
else
    # If it was stopped, start it
    desired_state="started"
    NOTIFICATION_ID=$("$NOTIFY_CMD" -p "$SERVICE_NAME will be $desired_state shortly")
    "$SERVICE_CMD" "$SERVICE_SCOPE" start "$SERVICE_NAME"
fi


# Check for NOTIFICATION_ID being empty, for robustness
if [ -z "$NOTIFICATION_ID" ] || [ "$NOTIFICATION_ID" -eq 0 ]; then
    echo "Warning: notify-send -p did not return a valid ID. Replacement may not work." >&2
    # Fallback to a non-replaceable notification
    "$NOTIFY_CMD"  "$SERVICE_NAME will be toggled from $initial_state"
fi

# Send notification based on the final state

while [ "$elapsed_time" -lt "$MAX_WAIT_TIME" ]; do
    current_status=$(get_service_status)
    if [ "$current_status" = "$desired_state" ]; then
        break # Service successfully reached target state, exit loop
    fi
    sleep "$POLLING_INTERVAL"
    elapsed_time=$((elapsed_time + POLLING_INTERVAL))
done

# final notification sends the final state after the loop ends
final_state=$(get_service_status)
if [ -n "$NOTIFICATION_ID" ] && [ "$NOTIFICATION_ID" -ne 0 ]; then
    "$NOTIFY_CMD"  -r "$NOTIFICATION_ID" "$SERVICE_NAME $final_state"
else
    # Fallback if no valid ID was captured
    "$NOTIFY_CMD" "$SERVICE_NAME $final_state"
fi

# Signal i3blocks to update status
pkill -RTMIN+3 i3blocks
